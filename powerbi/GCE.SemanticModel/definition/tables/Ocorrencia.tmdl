		summarizeBy: sum
		sourceColumn: qtd

		annotation SummarizationSetBy = Automatic

	/// Regra da vw_ocorrencia_colaborador_mes: versão do colaborador no HEADCOUNT do mês; quem não está no headcount usa a versão da última ocorrência do mês (data desc, ocorrencia_id desc). É a coluna do relacionamento com Colaborador.
	column colaborador_key_mes =
			VAR _id = Ocorrencia[colaborador_id]
			VAR _data = Ocorrencia[data_ocorrencia]
			RETURN
			    IF (
			        ISBLANK ( _data ),
			        Ocorrencia[colaborador_key],   // data inválida: fica fora das medidas ([Ocorrências]); mantém a versão original
			        VAR _ini = DATE ( YEAR ( _data ), MONTH ( _data ), 1 )
			        VAR _fim = EOMONTH ( _data, 0 )
			        VAR _doHeadcount =
			            LOOKUPVALUE ( Headcount[colaborador_key], Headcount[mes_ref], _ini, Headcount[colaborador_id], _id )
			        RETURN
			            IF (
			                NOT ISBLANK ( _doHeadcount ),
			                _doHeadcount,
			                VAR _ultima =
			                    TOPN (
			                        1,
			                        FILTER (
			                            ALL ( Ocorrencia[ocorrencia_id], Ocorrencia[colaborador_id], Ocorrencia[data_ocorrencia], Ocorrencia[data_valida], Ocorrencia[colaborador_key] ),
			                            Ocorrencia[colaborador_id] = _id
			                                && Ocorrencia[data_valida] = "1"
			                                && Ocorrencia[data_ocorrencia] >= _ini
			                                && Ocorrencia[data_ocorrencia] <= _fim
			                        ),
			                        Ocorrencia[data_ocorrencia], DESC,
			                        Ocorrencia[ocorrencia_id], DESC
			                    )
			                RETURN
			                    MAXX ( _ultima, Ocorrencia[colaborador_key] )
			            )
			    )
		isHidden
		lineageTag: 2232e057-227b-4173-8da3-ee250ac3fe03
		summarizeBy: none

	partition Ocorrencia = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents("C:\lumina\dados_pbi\pbi_fato_ocorrencia.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    CabecalhosPromovidos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    TiposAlterados = Table.TransformColumnTypes(CabecalhosPromovidos, {{"ocorrencia_id", Int64.Type}, {"data_ocorrencia", type date}, {"data_valida", type text}, {"colaborador_key", Int64.Type}, {"colaborador_id", Int64.Type}, {"gestor_key", Int64.Type}, {"tipo_ocorrencia_key", Int64.Type}, {"qtd", Int64.Type}}, "en-US")
				in
				    TiposAlterados

