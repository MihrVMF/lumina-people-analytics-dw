			column: nome

	partition Colaborador = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents("C:\lumina\dados_pbi\pbi_dim_colaborador.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    CabecalhosPromovidos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    TiposAlterados = Table.TransformColumnTypes(CabecalhosPromovidos, {{"colaborador_key", Int64.Type}, {"colaborador_id", Int64.Type}, {"funcionario_id_ponto", Int64.Type}, {"colaborador_id_gestao", Int64.Type}, {"versao", Int64.Type}, {"valido_de", type date}, {"valido_ate", type date}, {"atual", type text}, {"fonte_versao", type text}, {"origem", type text}, {"nome", type text}, {"empresa", type text}, {"area", type text}, {"area_fonte", type text}, {"setor", type text}, {"cargo", type text}, {"gestor_id", Int64.Type}, {"gestor_nome", type text}, {"gestor_fonte", type text}, {"situacao", type text}, {"data_admissao", type date}, {"data_demissao", type date}, {"motivo_demissao", type text}, {"motivo_demissao_codigo", type text}, {"tipo_desligamento", type text}, {"registra_ponto", type text}}, "en-US")
				in
				    TiposAlterados

