	/// Gestor da versão do colaborador, com "Sem gestor" no lugar do vazio (o SQL antigo fazia COALESCE). É o campo do slicer Gestor e da hierarquia.
	column gestor = COALESCE ( Colaborador[gestor_nome], "Sem gestor" )
		lineageTag: de14a390-ed7a-4e60-bd5b-c9588177c039
		summarizeBy: none

	hierarchy 'Área > Gestor > Colaborador'
		lineageTag: 668cba4f-bc65-4052-b106-35d22bafb3af

