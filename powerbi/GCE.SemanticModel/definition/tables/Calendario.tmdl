	/// Rótulo do mês igual ao do web app: "Set/2026" (antes: split_part no SQL).
	column mes_rotulo =
			VAR _abrev = LEFT ( Calendario[mes_ano_abrev], SEARCH ( "/", Calendario[mes_ano_abrev] ) - 1 )   // "Set/26" -> "Set"
			RETURN
			    _abrev & "/" & Calendario[ano]
		lineageTag: 2707144e-043f-4ee3-9637-3f05041bf3ce
		summarizeBy: none
		sortByColumn: mes_ref

	partition Calendario = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents("C:\lumina\dados_pbi\pbi_dim_calendario.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    CabecalhosPromovidos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    TiposAlterados = Table.TransformColumnTypes(CabecalhosPromovidos, {{"data", type date}, {"ano", Int64.Type}, {"mes", Int64.Type}, {"mes_ref", type date}, {"ano_mes", type text}, {"mes_nome", type text}, {"mes_ano_abrev", type text}, {"trimestre", Int64.Type}, {"ano_trimestre", type text}, {"dia_semana_iso", Int64.Type}, {"dia_semana_nome", type text}, {"fim_de_semana", type text}, {"feriado", type text}, {"feriado_nome", type text}, {"dia_util", type text}, {"mes_atual", type text}, {"ate_hoje", type text}}, "en-US")
				in
				    TiposAlterados

