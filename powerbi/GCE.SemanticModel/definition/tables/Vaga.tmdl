	/// Regra da vw_vaga: data de saída da vaga = fechamento ou, se não houver, cancelamento.
	column data_saida = COALESCE ( Vaga[data_fechamento], Vaga[data_cancelamento] )
		isHidden
		formatString: Short Date
		lineageTag: 615d42e7-362c-4b5c-9935-514132d40087

	partition Vaga = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents("C:\lumina\dados_pbi\pbi_fato_vaga.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    CabecalhosPromovidos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    TiposAlterados = Table.TransformColumnTypes(CabecalhosPromovidos, {{"vaga_id", Int64.Type}, {"data_abertura", type date}, {"data_fechamento", type date}, {"data_prazo", type date}, {"data_cancelamento", type date}, {"titulo", type text}, {"cargo", type text}, {"publicacao", type text}, {"tipo_vaga", type text}, {"status", type text}, {"situacao", type text}, {"sla_dias", Int64.Type}, {"dias_em_aberto", Int64.Type}, {"fechada_no_prazo", type text}, {"qtd_posicoes", Int64.Type}, {"qtd_posicoes_ocupadas", Int64.Type}, {"qtd_aberta", Int64.Type}, {"qtd_fechada", Int64.Type}, {"qtd_cancelada", Int64.Type}, {"cidade", type text}, {"uf", type text}}, "en-US")
				in
				    TiposAlterados

	annotation PBI_ResultType = Table

