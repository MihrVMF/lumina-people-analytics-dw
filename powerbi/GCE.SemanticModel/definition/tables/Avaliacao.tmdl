	partition Avaliacao = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents("C:\lumina\dados_pbi\pbi_fato_avaliacao.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    CabecalhosPromovidos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    TiposAlterados = Table.TransformColumnTypes(CabecalhosPromovidos, {{"avaliacao_id", type text}, {"ciclo_key", Int64.Type}, {"data_referencia", type date}, {"data_avaliacao", type date}, {"colaborador_key", Int64.Type}, {"colaborador_id", Int64.Type}, {"gestor_key", Int64.Type}, {"versao", Int64.Type}, {"respondida", type text}, {"criterio_id", Int64.Type}, {"criterio_tipo", type text}, {"criterio_descricao", type text}, {"nota", type number}, {"peso", type number}, {"nota_pct", type number}, {"departamento_avaliado", type text}, {"qtd_avaliacao", Int64.Type}, {"qtd_respondida", Int64.Type}}, "en-US")
				in
				    TiposAlterados

