	/// Pessoa (chave durável) da versão do colaborador. Apoio da variação do mês, que soma todas as versões da pessoa.
	column colaborador_id = LOOKUPVALUE ( Colaborador[colaborador_id], Colaborador[colaborador_key], 'Ponto Diario'[colaborador_key] )
		isHidden
		lineageTag: 63c5c340-7dce-4e89-a9a9-b24cbf44cc2f
		summarizeBy: none

	/// Regra da vw_banco_horas: saldo acumulado só no último dia apurado do mês e só de quem estava ativo no fim do mês (demissão vazia ou depois do fim do mês, limitado a hoje no mês corrente). Fora disso: VAZIO, nunca 0.
	column saldo_banco_fim_min =
			IF ( 'Ponto Diario'[ultimo_dia_mes] = "1",
			    VAR _fimMes = EOMONTH ( 'Ponto Diario'[data], 0 )
			    VAR _hoje =
			        MAXX ( FILTER ( ALLNOBLANKROW ( Calendario[data], Calendario[ate_hoje] ), Calendario[ate_hoje] = "1" ), Calendario[data] )
			    VAR _corte = MIN ( _fimMes, _hoje )
			    VAR _demissao =
			        LOOKUPVALUE ( Colaborador[data_demissao], Colaborador[colaborador_key], 'Ponto Diario'[colaborador_key] )
			    RETURN
			        IF ( ISBLANK ( _demissao ) || _demissao > _corte, 'Ponto Diario'[saldo_banco_min] )   // sem ELSE = vazio
			)
		isHidden
		lineageTag: 43b33211-cd52-4f85-8014-23c5d797febc

	/// Regra da vw_banco_horas: soma do saldo diário da PESSOA no mês (todas as versões), gravada só na linha do último dia apurado (fica na área/gestor desse dia).
	column variacao_banco_mes_min =
			IF ( 'Ponto Diario'[ultimo_dia_mes] = "1",
			    VAR _id = 'Ponto Diario'[colaborador_id]
			    VAR _ini = DATE ( YEAR ( 'Ponto Diario'[data] ), MONTH ( 'Ponto Diario'[data] ), 1 )
			    VAR _fim = EOMONTH ( 'Ponto Diario'[data], 0 )
			    RETURN
			        CALCULATE (
			            SUM ( 'Ponto Diario'[saldo_dia_min] ),
			            REMOVEFILTERS ( 'Ponto Diario' ),
			            'Ponto Diario'[colaborador_id] = _id,
			            'Ponto Diario'[data] >= _ini,
			            'Ponto Diario'[data] <= _fim
			        )
			)
		isHidden
		lineageTag: f00d59b7-8716-45e3-b06d-5c96709c0589

	partition 'Ponto Diario' = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents("C:\lumina\dados_pbi\pbi_fato_ponto_diario.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    CabecalhosPromovidos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    TiposAlterados = Table.TransformColumnTypes(CabecalhosPromovidos, {{"data", type date}, {"colaborador_key", Int64.Type}, {"gestor_key", Int64.Type}, {"previsto_min", Int64.Type}, {"trabalhado_min", Int64.Type}, {"ausencia_min", Int64.Type}, {"ausencia_liquida_min", Int64.Type}, {"horas_normais_min", Int64.Type}, {"excedente_min", Int64.Type}, {"excedente_util_min", Int64.Type}, {"he_paga_min", Int64.Type}, {"he_paga_fonte", type text}, {"domingo_feriado", type text}, {"saldo_dia_min", Int64.Type}, {"saldo_banco_min", Int64.Type}, {"ultimo_dia_mes", type text}, {"dia_sem_marcacao", type text}, {"fonte", type text}}, "en-US")
				in
				    TiposAlterados

