	column ativo_fim
		dataType: int64
		formatString: 0
		lineageTag: 2105f335-0f2b-47b0-9ba6-5c38d7acbafe
		summarizeBy: sum
		sourceColumn: ativo_fim

		annotation SummarizationSetBy = Automatic

	/// Regra da vw_ocorrencia_colaborador_mes (coberto): 1 se a pessoa recebeu >= 1 feedback com data válida no mês do headcount, senão 0.
	column recebeu_feedback =
			VAR _id = Headcount[colaborador_id]
			VAR _ini = Headcount[mes_ref]
			VAR _fim = EOMONTH ( Headcount[mes_ref], 0 )
			VAR _tiposFeedback =
			    SELECTCOLUMNS (
			        FILTER (
			            ALLNOBLANKROW ( 'Tipo Ocorrencia'[tipo_ocorrencia_key], 'Tipo Ocorrencia'[grupo] ),
			            'Tipo Ocorrencia'[grupo] = "Feedback"
			        ),
			        "k", 'Tipo Ocorrencia'[tipo_ocorrencia_key]
			    )
			VAR _recebeu =
			    NOT ISEMPTY (
			        FILTER (
			            ALL ( Ocorrencia[colaborador_id], Ocorrencia[data_ocorrencia], Ocorrencia[data_valida], Ocorrencia[tipo_ocorrencia_key] ),
			            Ocorrencia[colaborador_id] = _id
			                && Ocorrencia[data_valida] = "1"
			                && Ocorrencia[data_ocorrencia] >= _ini
			                && Ocorrencia[data_ocorrencia] <= _fim
			                && Ocorrencia[tipo_ocorrencia_key] IN _tiposFeedback
			        )
			    )
			RETURN
			    IF ( _recebeu, 1, 0 )
		isHidden
		lineageTag: a7957931-b659-4834-bb90-d26d7907d0e1

	partition Headcount = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents("C:\lumina\dados_pbi\pbi_fato_headcount_mensal.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    CabecalhosPromovidos = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    TiposAlterados = Table.TransformColumnTypes(CabecalhosPromovidos, {{"mes_ref", type date}, {"colaborador_key", Int64.Type}, {"gestor_key", Int64.Type}, {"colaborador_id", Int64.Type}, {"dias_periodo", Int64.Type}, {"dias_ativos", Int64.Type}, {"ativo_inicio", Int64.Type}, {"ativo_fim", Int64.Type}}, "en-US")
				in
				    TiposAlterados

